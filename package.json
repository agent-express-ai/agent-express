{
  "name": "agent-express",
  "version": "0.1.0",
  "description": "Minimalist middleware framework for building AI agents in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-express": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/handler.js",
      "types": "./dist/http/handler.d.ts"
    },
    "./test": {
      "import": "./dist/test/index.js",
      "types": "./dist/test/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "commander": "^13.0.0",
    "starlight-llms-txt": "^0.8.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-express-ai/agent-express.git"
  },
  "homepage": "https://github.com/agent-express-ai/agent-express#readme",
  "bugs": {
    "url": "https://github.com/agent-express-ai/agent-express/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "middleware",
    "llm",
    "typescript",
    "anthropic",
    "openai",
    "mcp",
    "framework"
  ],
  "author": "agent-express contributors",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
