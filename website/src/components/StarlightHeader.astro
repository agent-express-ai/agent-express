---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper">
    <a href="/" class="site-logo">
      <img src="/logo.png" alt="" width="28" height="28" />
      <span>agent-express</span>
    </a>
  </div>
  <div class="sl-flex print:hidden search-center">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/getting-started/">Docs</a>
      <a href="/blog/">Blog</a>
    </nav>
    <span class="divider"></span>
    <div class="external-links">
      <a href="https://www.npmjs.com/package/agent-express" class="icon-link" aria-label="npm">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M0 0v16h16V0H0zm13 13H8V5h3v8h2V3H3v10H0V0h16v13h-3z"/></svg>
      </a>
      <a href="https://github.com/agent-express-ai/agent-express" class="icon-link" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
    <span class="divider"></span>
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: visible;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: max-content;
    }

    .site-logo {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
      color: var(--sl-color-white);
    }

    .site-logo img {
      height: 28px;
      width: auto;
    }

    .site-logo span {
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.6;
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    }

    .right-group {
      display: flex;
      gap: 0;
      align-items: center;
      flex-shrink: 0;
    }

    .nav-links {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }

    .nav-links a {
      color: var(--sl-color-gray-3);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1.6;
      padding: 0.5rem 0.625rem;
      border-radius: 0.375rem;
      transition: color 0.15s;
    }

    .nav-links a:hover {
      color: var(--sl-color-white);
    }

    .divider {
      width: 1px;
      height: 1.25rem;
      background: var(--sl-color-gray-5, #334155);
      margin: 0 0.625rem;
      flex-shrink: 0;
    }

    .external-links {
      display: flex;
      gap: 0.125rem;
      align-items: center;
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem;
      border-radius: 0.375rem;
      color: var(--sl-color-gray-3);
      transition: color 0.15s;
    }

    .icon-link:hover {
      color: var(--sl-color-white);
    }

    .icon-link svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
      display: block;
    }

    .search-center {
      flex: 1;
      justify-content: center;
    }

    @media (min-width: 50rem) {
      .header {
        display: flex;
        gap: var(--sl-nav-gap);
        justify-content: space-between;
        align-items: center;
      }
    }
  }
</style>
