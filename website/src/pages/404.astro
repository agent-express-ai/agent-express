---
const title = "Page not found — agent-express"
const description = "The page you're looking for doesn't exist."
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: #111827;
        color: #f8fafc;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #1e293b;
      }
      header a {
        color: #f8fafc;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.125rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      header img { height: 1.5rem; }
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 1.5rem;
        text-align: center;
        padding: 2rem;
      }
      .code { font-size: 6rem; font-weight: 800; color: #1e293b; line-height: 1; }
      h1 { font-size: 1.5rem; font-weight: 600; }
      .desc { color: #94a3b8; max-width: 28rem; line-height: 1.6; }
      .actions { display: flex; gap: 1rem; margin-top: 0.5rem; }
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.625rem 1.25rem;
        border-radius: 0.375rem;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9375rem;
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.85; }
      .btn-primary { background: #7c3aed; color: #fff; }
      .btn-secondary { border: 1px solid #334155; color: #cbd5e1; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">
        <img src="/logo.png" alt="agent-express" />
        agent-express
      </a>
    </header>
    <main>
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p class="desc">
        The page you're looking for doesn't exist or has been moved.
        Try searching the documentation or head back to the homepage.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/getting-started/" class="btn btn-secondary">Documentation →</a>
      </div>
    </main>
  </body>
</html>
