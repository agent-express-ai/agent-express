---
import Hero from "../components/Hero.astro"
import AnimatedTerminal from "../components/AnimatedTerminal.astro"
import ComparisonTable from "../components/ComparisonTable.astro"
import MiddlewareTabs from "../components/MiddlewareTabs.astro"

const title = "agent-express — Middleware framework for AI agents"
const description =
  "The (ctx, next) you already know — for AI agents. Express.js middleware pattern for building AI agents in TypeScript."
---

<html lang="en" data-theme="dark">
<script is:inline>
  (function(){var t=localStorage.getItem('starlight-theme');document.documentElement.setAttribute('data-theme',t==='light'?'light':t==='dark'?'dark':window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark')})();
</script>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://agent-express.ai" />
    <meta property="og:image" content="https://agent-express.ai/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { overflow-y: scroll; }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      /* ---- Header (p.1, p.9) ---- */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
        padding-block: 0;
        padding-inline: 1.5rem;
        background: var(--header-bg);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .header-logo {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        text-decoration: none;
        color: #f8fafc;
      }
      .header-logo img { height: 28px; width: auto; }
      .header-logo span {
        font-weight: 600;
        font-size: 1.0625rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
        color: var(--text);
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 0;
        flex-shrink: 0;
        margin-left: auto;
      }
      .nav-links {
        display: flex;
        gap: 0.25rem;
        align-items: center;
      }
      .nav-links a {
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.5rem 0.625rem;
        font-size: 0.875rem;
        border-radius: 0.375rem;
        transition: color 0.15s;
      }
      .nav-links a:hover { color: var(--text); }
      .divider {
        width: 1px;
        height: 1.25rem;
        background: var(--sl-color-gray-5, #334155);
        margin: 0 0.625rem;
        flex-shrink: 0;
      }
      .external-links {
        display: flex;
        gap: 0.125rem;
        align-items: center;
      }
      .icon-link {
        display: inline-flex;
        align-items: center;
        padding: 0.375rem;
        color: var(--text-muted);
        border-radius: 0.375rem;
        transition: color 0.15s;
      }
      .icon-link:hover { color: var(--text); }
      .icon-link svg { width: 18px; height: 18px; fill: currentColor; display: block; }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }
      /* Theme select — Starlight's exact CSS extracted */
      .ts-label {
        --sl-label-icon-size: 0.875rem;
        --sl-caret-size: 1.25rem;
        --sl-inline-padding: 0.5rem;
        --sl-select-width: 6.25em;
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--sl-color-gray-2, #cbd5e1);
      }
      .ts-label:hover { color: var(--sl-color-white, #f8fafc); }
      .ts-label .ts-icon {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
      }
      .ts-label .ts-label-icon {
        font-size: var(--sl-label-icon-size);
        width: 1em;
        height: 1em;
        inset-inline-start: 0;
      }
      .ts-label .ts-caret {
        font-size: var(--sl-caret-size);
        width: 1em;
        height: 1em;
        inset-inline-end: 0;
      }
      .ts-label select {
        border: 0;
        padding-block: 0.625rem;
        padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
          calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
        margin-inline: calc(var(--sl-inline-padding) * -1);
        width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
        background-color: transparent;
        text-overflow: ellipsis;
        color: inherit;
        cursor: pointer;
        appearance: none;
        font-size: 0.875rem;
        line-height: 1.75;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      .ts-label option { background: var(--bg); color: var(--text); }

      /* ---- CSS custom properties for theming ---- */
      :root, [data-theme="dark"] {
        --bg: #111827;
        --bg-subtle: #0f172a;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --text-faint: #64748b;
        --border: #1e293b;
        --card-bg: #0f172a;
        --header-bg: rgba(17, 24, 39, 0.85);
        --accent: #7c3aed;
        --accent-light: #a78bfa;
        --badge-bg: #0f172a;
        --sl-color-gray-2: #cbd5e1;
        --sl-color-gray-5: #334155;
        --sl-color-white: #f8fafc;
        --sl-color-bg-nav: #111827;
        --sl-color-gray-1: #e2e8f0;
      }
      [data-theme="light"] {
        --bg: #ffffff;
        --bg-subtle: #f8fafc;
        --text: #1e293b;
        --text-muted: #64748b;
        --text-faint: #94a3b8;
        --border: #e2e8f0;
        --card-bg: #f8fafc;
        --header-bg: rgba(255, 255, 255, 0.85);
        --accent: #7c3aed;
        --accent-light: #5b21b6;
        --badge-bg: #f1f5f9;
        --sl-color-gray-2: #475569;
        --sl-color-gray-5: #e2e8f0;
        --sl-color-white: #1e293b;
        --sl-color-bg-nav: #ffffff;
        --sl-color-gray-1: #334155;
      }

      /* ---- Sections ---- */
      .section {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      .section-title {
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 2rem;
      }

      /* ---- Providers (p.4: text only, no logos) ---- */
      .providers {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 0;
        color: var(--text-faint);
        font-size: 0.875rem;
      }
      .provider-name {
        color: var(--text-muted);
        font-weight: 600;
      }

      /* ---- Features ---- */
      .features {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0.75rem;
        max-width: 56rem;
        margin: 1.5rem auto 0;
        text-align: left;
      }
      .feature-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.15s;
      }
      .feature-item:hover {
        background: var(--card-bg);
      }
      .feature-icon {
        font-size: 1.25rem;
        line-height: 1;
      }
      .feature-name {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text);
      }
      .feature-desc {
        font-size: 0.6875rem;
        color: var(--text-faint);
      }
      @media (max-width: 640px) {
        .features { grid-template-columns: repeat(2, 1fr); }
      }

      /* ---- Badges ---- */
      .badges {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 9999px;
        font-size: 0.8125rem;
        color: var(--text-muted);
        background: var(--badge-bg);
      }
      .badge .dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #22c55e;
      }

      /* ---- Section subtitle ---- */
      .section-subtitle {
        text-align: center;
        color: var(--text-muted);
        margin: -1rem auto 1.5rem;
        max-width: 36rem;
        font-size: 0.9375rem;
      }
      .scaffold-code {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #011627;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
        font-size: 0.875rem;
        color: #c4b5fd;
        max-width: 40rem;
        margin: 0 auto;
        cursor: pointer;
        transition: border-color 0.15s;
      }
      .scaffold-code:hover {
        border-color: #7c3aed;
      }
      .scaffold-code .copy-hint {
        color: #64748b;
        flex-shrink: 0;
        margin-left: 0.75rem;
        display: inline-flex;
        align-items: center;
        transition: color 0.15s;
      }
      .scaffold-code:hover .copy-hint { color: #94a3b8; }

      /* ---- Templates ---- */
      .templates {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        max-width: 60rem;
        margin: 0 auto;
      }
      .template-card {
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: var(--card-bg);
      }
      .template-card h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.375rem;
      }
      .template-card p {
        font-size: 0.8125rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .template-cmd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #011627;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
        font-size: 0.75rem;
        color: #c4b5fd;
        cursor: pointer;
        transition: border-color 0.15s;
      }
      .template-cmd:hover {
        border-color: #7c3aed;
      }
      .template-cmd .copy-hint {
        color: #64748b;
        flex-shrink: 0;
        margin-left: 0.5rem;
        display: inline-flex;
        align-items: center;
        transition: color 0.15s;
      }
      .template-cmd:hover .copy-hint { color: #94a3b8; }

      /* ---- FAQ ---- */
      .faq {
        max-width: 48rem;
        margin: 0 auto;
      }
      .faq details {
        border-bottom: 1px solid var(--border);
        padding: 1rem 0;
      }
      .faq summary {
        font-weight: 600;
        cursor: pointer;
        color: var(--text);
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .faq summary::after {
        content: "+";
        font-size: 1.25rem;
        color: #7c3aed;
        transition: transform 0.2s;
      }
      .faq details[open] summary::after {
        content: "\2212";
      }
      .faq .answer {
        color: var(--text-muted);
        margin-top: 0.75rem;
        font-size: 0.9375rem;
        line-height: 1.7;
      }
      .faq .answer a { color: #7c3aed; }
      .faq .answer code {
        background: var(--card-bg);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.8125rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
      }

      /* ---- Footer (p.10: remove "contributors") ---- */
      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 1.5rem;
        text-align: center;
        color: var(--text-faint);
        font-size: 0.875rem;
      }

      @media (max-width: 640px) {
        .section { padding: 2rem 1rem; }
        .section-title { font-size: 1.375rem; }
        .providers { gap: 1rem; flex-wrap: wrap; }
        .header-nav a { padding: 0.5rem 0.375rem; font-size: 0.8125rem; }
      }
    </style>
  </head>
  <body>
    <!-- Header (p.1 + p.9) -->
    <header class="site-header">
      <a href="/" class="header-logo">
        <img src="/logo.png" alt="" />
        <span>agent-express</span>
      </a>
      <div class="header-right">
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/getting-started/">Docs</a>
          <a href="/blog/agent-express-vs-alternatives/">Blog</a>
        </nav>
        <span class="divider"></span>
        <div class="external-links">
          <a href="https://www.npmjs.com/package/agent-express" class="icon-link" aria-label="npm">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M0 0v16h16V0H0zm13 13H8V5h3v8h2V3H3v10H0V0h16v13h-3z"/></svg>
          </a>
          <a href="https://github.com/agent-express-ai/agent-express" class="icon-link" aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
        </div>
        <span class="divider"></span>
        <label class="ts-label">
          <span class="sr-only">Select theme</span>
          <svg id="ts-icon" aria-hidden="true" class="ts-icon ts-label-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"></svg>
          <select id="theme-select" autocomplete="off">
            <option value="dark">Dark</option>
            <option value="light">Light</option>
            <option value="auto" selected>Auto</option>
          </select>
          <svg aria-hidden="true" class="ts-icon ts-caret" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"></path></svg>
        </label>
      </div>
    </header>
    <div style="height:4rem;"></div>
    <script>
      const KEY = 'starlight-theme';
      const ICONS = {
        light: '<path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/>',
        dark: '<path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/>',
        auto: '<path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/>',
      };
      function resolve(v) {
        if (v === 'light' || v === 'dark') return v;
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      function apply() {
        const raw = localStorage.getItem(KEY);
        const stored = raw === 'light' ? 'light' : raw === 'dark' ? 'dark' : 'auto';
        document.documentElement.setAttribute('data-theme', resolve(stored));
        const sel = document.getElementById('theme-select');
        if (sel) sel.value = stored;
        const icon = document.getElementById('ts-icon');
        if (icon) icon.innerHTML = ICONS[stored] || ICONS.auto;
      }
      apply();
      document.getElementById('theme-select')?.addEventListener('change', (e) => {
        const v = e.target.value;
        localStorage.setItem(KEY, v === 'auto' ? '' : v);
        apply();
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        const raw = localStorage.getItem(KEY);
        if (!raw) apply();
      });

      // Scaffold command copy
      const scaffoldCmd = document.getElementById('scaffold-cmd');
      if (scaffoldCmd) {
        scaffoldCmd.addEventListener('click', () => {
          navigator.clipboard.writeText(scaffoldCmd.dataset.cmd || '').then(() => {
            const hint = scaffoldCmd.querySelector('.copy-hint');
            if (hint) { const orig = hint.innerHTML; hint.innerHTML = '✓'; setTimeout(() => { hint.innerHTML = orig; }, 2000); }
          });
        });
      }

      // Template command copy
      document.querySelectorAll('.template-cmd').forEach(el => {
        el.addEventListener('click', () => {
          const cmd = el.dataset.cmd;
          if (cmd) {
            navigator.clipboard.writeText(cmd).then(() => {
              const hint = el.querySelector('.copy-hint');
              if (hint) {
                const orig = hint.innerHTML;
                hint.innerHTML = '✓';
                setTimeout(() => { hint.innerHTML = orig; }, 2000);
              }
            });
          }
        });
      });
    </script>

    <!-- Hero (logo removed from hero, now in header) -->
    <Hero />

    <!-- Try it now -->
    <div class="section">
      <h2 class="section-title">Try it now</h2>
      <AnimatedTerminal />
      <div class="scaffold-code" id="scaffold-cmd" data-cmd="npx create-agent-express --template support-bot" style="margin-top:1.5rem;">
        <span><span style="color:#64748b;">$</span> npx create-agent-express --template support-bot</span>
        <span class="copy-hint"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 10.5V3C3 2.17157 3.67157 1.5 4.5 1.5H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
      </div>
    </div>

    <!-- Built for production -->
    <div class="section" style="text-align:center;">
      <h2 class="section-title">Built for production</h2>
      <div class="providers" style="margin-bottom:1rem;">
        <span>Works with</span>
        <span class="provider-name">Anthropic</span>
        <span class="provider-name">OpenAI</span>
        <span class="provider-name">Google</span>
        <span class="provider-name">Mistral</span>
        <span class="provider-name">Groq</span>
        <span class="provider-name">DeepSeek</span>
        <span style="color:#475569;font-style:italic;">+ any AI SDK provider</span>
      </div>
      <div class="badges">
        <span class="badge"><span class="dot"></span> 600+ tests</span>
        <span class="badge">TypeScript strict</span>
        <span class="badge">MIT license</span>
        <span class="badge">ESM only</span>
        <span class="badge">Node.js 20+</span>
      </div>
      <div class="features">
        <a href="/guides/builtins/guard/" class="feature-item">
          <span class="feature-icon">&#128737;</span>
          <span class="feature-name">Guardrails</span>
          <span class="feature-desc">Input/output validation</span>
        </a>
        <a href="/guides/builtins/guard/#guardbudget" class="feature-item">
          <span class="feature-icon">&#128176;</span>
          <span class="feature-name">Cost Tracking</span>
